# Copy this file to .env and fill in real values. Never commit .env itself.

# Required — the signing key for issued JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional — JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Optional — defaults to a local SQLite file if unset.
# Railway's Postgres plugin sets this automatically when attached.
DATABASE_URL=sqlite:///./silver_memory.db

# Comma-separated list of origins allowed to call this API.
# Add your deployed frontend's real domain once you have one.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only used by seed.py, to create the one passkey row. Not read by the app itself.
MASTER_PASSKEY=
